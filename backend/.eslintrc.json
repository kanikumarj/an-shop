{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": "airbnb-base",
  "plugins": ["import"],
  "rules": {
    "no-console": "warn",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "next|req|res" }],
    "consistent-return": "off",
    "no-underscore-dangle": "off",
    "no-await-in-loop": "off",
    "no-restricted-syntax": "off",
    "import/no-extraneous-dependencies": ["error", { "devDependencies": ["**/*.test.js", "**/*.spec.js", "**/seed.js"] }],
    "prefer-destructuring": "off",
    "radix": "off"
  }
}
